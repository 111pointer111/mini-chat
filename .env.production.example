# Mini-Chat production environment
# Usage:
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# Docker Hub namespace used by docker-compose.prod.yml
DOCKERHUB_USERNAME=your_dockerhub_username

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=replace_with_strong_password

# Redis (optional if you need password-protected Redis in custom deployments)
REDIS_PASSWORD=

# PostgreSQL + pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=minichat

# Application auth
JWT_SECRET=replace_with_a_long_random_string

# Admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_EMAIL=admin@example.com

# Optional default AI provider fallback
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Aliyun SMS (optional)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
