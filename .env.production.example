# Mini-Chat 生产环境配置
# 复制此文件为 .env.production 并填写实际值

# Docker Hub 用户名
DOCKER_USERNAME=your_docker_username

# MongoDB 配置
MONGO_USER=admin
MONGO_PASSWORD=your_secure_password_here

# JWT 密钥 (使用强随机字符串)
JWT_SECRET=your_jwt_secret_at_least_32_chars

# AI 配置 (支持 OpenAI 兼容格式的任意模型)
# 示例配置：
# OpenAI: AI_BASE_URL=https://api.openai.com/v1, AI_MODEL=gpt-4
# Claude: AI_BASE_URL=https://api.anthropic.com/v1, AI_MODEL=claude-3-sonnet-20240229
# DeepSeek: AI_BASE_URL=https://api.deepseek.com/v1, AI_MODEL=deepseek-chat
# 其他兼容服务: 填写对应的 base URL 和模型名
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_ai_api_key
AI_MODEL=gpt-4
