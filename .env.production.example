# Mini-Chat production environment
# Usage:
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# Docker Hub namespace used by docker-compose.prod.yml
DOCKERHUB_USERNAME=your_dockerhub_username

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=replace_with_strong_password

# Redis (optional if you need password-protected Redis in custom deployments)
REDIS_PASSWORD=

# PostgreSQL + pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=minichat

# Application auth
JWT_SECRET=replace_with_a_long_random_string

# Admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_EMAIL=admin@example.com

# Optional default AI provider fallback
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=

# Aliyun SMS (optional)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# Aliyun SMTP (email verification)
ALIYUN_SMTP_HOST=smtpdm.aliyun.com
ALIYUN_SMTP_PORT=465
ALIYUN_SMTP_USER=your_smtp_user
ALIYUN_SMTP_PASS=your_smtp_password
ALIYUN_SMTP_SENDER_NAME=Mini Chat

# Monitoring alerts
ALERT_EMAIL=admin@example.com
ALERT_MIN_SEVERITY=warning
ALERT_ERROR_RATE_PERCENT=2
ALERT_ERROR_RATE_MIN_REQUESTS=20
ALERT_SERVICE_DOWN_MIN_REQUESTS=5
ALERT_LATENCY_P95_MS=800
ALERT_LATENCY_MIN_SAMPLES=30
ALERT_MEMORY_MB=350
ALERT_EVENT_LOOP_LAG_MS=200
ALERT_COOLDOWN_MS=300000
ENABLE_MONITORING_TEST_ROUTES=false
MONITORING_TEST_TOKEN=

# CORS allowed origins (comma-separated, optional)
CORS_ORIGINS=
