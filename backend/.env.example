PORT=5000

# MongoDB
MONGODB_URI=mongodb://admin:password@localhost:27017/mini-chat?authSource=admin

# Auth
JWT_SECRET=replace_me_with_a_long_random_string

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL + pgvector (knowledge base)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=minichat

# Optional AI fallback (used when no provider is configured in admin UI)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Admin bootstrap (development defaults)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@minichat.com

# Aliyun SMS (optional)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# Knowledge base embedding batch size (optional)
KB_EMBEDDING_BATCH_SIZE=2
