PORT=5000

# MongoDB
MONGODB_URI=mongodb://admin:password@localhost:27017/mini-chat?authSource=admin

# Auth
JWT_SECRET=replace_me_with_a_long_random_string

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL + pgvector (knowledge base)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=minichat

# Optional AI fallback (used when no provider is configured in admin UI)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=

# Admin bootstrap (development defaults)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@minichat.com

# Aliyun SMS (optional)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# Aliyun SMTP (email verification)
ALIYUN_SMTP_HOST=smtpdm.aliyun.com
ALIYUN_SMTP_PORT=465
ALIYUN_SMTP_USER=your_smtp_user
ALIYUN_SMTP_PASS=your_smtp_password
ALIYUN_SMTP_SENDER=your_email@your_domain.com

# Knowledge base embedding batch size (optional)
KB_EMBEDDING_BATCH_SIZE=2

# Monitoring alerts
ALERT_EMAIL=
ALERT_MIN_SEVERITY=warning
ALERT_ERROR_RATE_PERCENT=2
ALERT_ERROR_RATE_MIN_REQUESTS=20
ALERT_SERVICE_DOWN_MIN_REQUESTS=5
ALERT_LATENCY_P95_MS=800
ALERT_LATENCY_MIN_SAMPLES=30
ALERT_MEMORY_MB=350
ALERT_EVENT_LOOP_LAG_MS=200
ALERT_COOLDOWN_MS=300000
ENABLE_MONITORING_TEST_ROUTES=false
MONITORING_TEST_TOKEN=

# CORS allowed origins (comma-separated, optional)
CORS_ORIGINS=
